# Continuous backup settings. Copy to infra/.env.pitr (git ignores it),
# fill in the values, then run infra/pitr-setup.sh.
#
#   cp infra/pitr/pitr.env.example infra/.env.pitr
#   chmod 600 infra/.env.pitr
#
# The postgres container reads this file when the stack is started
# with infra/docker-compose.pitr.yml. Design and bucket settings:
# docs/cloud/backup-design.md.

# Backblaze B2 S3 endpoint and region for the bucket. Both are shown
# on the bucket's page, for example s3.us-west-004.backblazeb2.com
# and us-west-004.
PGBACKREST_REPO1_S3_ENDPOINT=CHANGE_ME
PGBACKREST_REPO1_S3_REGION=CHANGE_ME

# A bucket used only for database backups. Not the portal's file bucket.
PGBACKREST_REPO1_S3_BUCKET=CHANGE_ME

# Application key restricted to this bucket with listBuckets,
# listFiles, readFiles and writeFiles. No deleteFiles.
PGBACKREST_REPO1_S3_KEY=CHANGE_ME
PGBACKREST_REPO1_S3_KEY_SECRET=CHANGE_ME

# Encryption passphrase. pitr-setup.sh --new-key writes a random one
# here. Keep a copy in the owner's password manager: without it the
# backups cannot be read, and it is not stored in the bucket.
# Never change it once backups exist.
PGBACKREST_REPO1_CIPHER_PASS=CHANGE_ME
