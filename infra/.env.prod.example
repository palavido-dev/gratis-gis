# Production environment for the gratisgis.org stack. Copy this file
# to `infra/.env.prod` on the deploy host and fill in real values.
# Never commit `.env.prod` itself; it's gitignored.
#
# Generate strong values for any line that says "GENERATE":
#   openssl rand -base64 36
#
# Once values are set, deploy with:
#   docker compose -f infra/docker-compose.prod.yml --env-file infra/.env.prod up -d --build

# --- Public hostnames ---
PORTAL_DOMAIN=gratisgis.org
AUTH_DOMAIN=auth.gratisgis.org
# Public-facing MinIO. Browsers PUT presigned uploads and GET public
# blobs (thumbnails, hero images, attachments) at this hostname.
# Caddy terminates TLS and reverse-proxies to the in-cluster minio
# container. Signature v4 covers the Host header, so this has to be
# the SAME host the api uses as MINIO_ENDPOINT (compose wires it).
STORAGE_DOMAIN=storage.gratisgis.org
PUBLIC_URL=https://gratisgis.org

# --- Let's Encrypt ---
# Email Let's Encrypt notifies if cert renewal fails. Use a real
# inbox you check. Fork operators should change this to their own
# address; otherwise renewal-failure notices end up in the
# upstream maintainer's inbox.
ACME_EMAIL=you@example.com

# --- Postgres (app DB) ---
POSTGRES_DB=gratisgis
POSTGRES_USER=gratisgis
POSTGRES_PASSWORD=GENERATE
# Separate password for the keycloak role + database created in
# init-prod-db.sh. Different from POSTGRES_PASSWORD on purpose so a
# leak of one doesn't compromise both.
KEYCLOAK_DB_PASSWORD=GENERATE

# --- MinIO (object storage) ---
MINIO_ROOT_USER=gratisgis
MINIO_ROOT_PASSWORD=GENERATE
S3_BUCKET=gratisgis

# --- Keycloak ---
KEYCLOAK_REALM=gratis-gis
KEYCLOAK_HOSTNAME=auth.gratisgis.org
KEYCLOAK_ISSUER=https://auth.gratisgis.org/realms/gratis-gis
KEYCLOAK_ADMIN=admin
# Initial bootstrap admin password. You log into the Keycloak admin
# console at https://auth.gratisgis.org/admin/ with this; create real
# users from there.
KEYCLOAK_ADMIN_PASSWORD=GENERATE

# portal-web is a public client (PKCE auth code flow) so its
# "secret" is the empty string. The variable still has to be
# present for NextAuth's KeycloakProvider to register at boot.
KEYCLOAK_CLIENT_ID=portal-web
KEYCLOAK_CLIENT_SECRET=

# portal-api-admin is a CONFIDENTIAL service-account client used by
# the api for user-reconcile / role mutation. The realm-import
# substitutes this secret into the realm JSON, and the api reads it
# from this env var to authenticate against Keycloak's admin REST.
KEYCLOAK_ADMIN_CLIENT_ID=portal-api-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=GENERATE
# Optional. Comma-separated Keycloak client ids (`azp`) allowed to
# call portal-api. Default in code: portal-web,field-app,qgis-plugin.
# JWT_ALLOWED_AZP=

# --- Credential encryption ---
# AES-256-GCM master key for stored credentials (item credentials,
# SMTP password). 32 bytes, base64-encoded. Generate with:
#   openssl rand -base64 32
# Treat as effectively immutable: rotating it makes every encrypted
# row in item_credential and system_setting unreadable.
CREDENTIAL_ENCRYPTION_KEY=GENERATE

# Initial admin user seeded into the realm. The temporary flag is on
# so Keycloak forces a password change on first login.
INITIAL_USER_PASSWORD=GENERATE

# Default org slug seeded onto the initial admin user (org claim in
# the JWT). The api creates the org row from this slug on first auth.
DEFAULT_ORG_SLUG=gratis-gis

# --- NextAuth ---
# JWT signing key for NextAuth's own session tokens (separate from
# the Keycloak access tokens). 32+ bytes of random.
NEXTAUTH_SECRET=GENERATE

# --- Print rendering ---
# Shared token for the two Chromium sidecars and for portal-api.
# Required even if you never print: Compose refuses to start when
# this is empty. That is the "CHROMIUM_TOKEN is missing" error an
# empty Dockge or TrueNAS env box shows. Generate with:
#   openssl rand -base64 36
CHROMIUM_TOKEN=GENERATE

# --- User scripts (optional profile) ---
# Compose interpolates this even when the scripts profile is off,
# so a value is required for `docker compose up` to parse. It is
# not a password you type. Generate with:
#   openssl rand -base64 36
SCRIPT_EXECUTOR_TOKEN=GENERATE

# --- Optional: demo traffic analytics (/_stats) ---
# Basic-auth credentials for the analytics dashboard Caddy serves at
# /_stats. Generate the hash with:
#   docker run --rm caddy caddy hash-password --plaintext 'your-password'
# Single-quote it. A bcrypt hash is mostly dollar signs, and an
# unquoted one gets mangled by anything that treats this file as
# shell (infra/lib-env.sh exists so our own scripts no longer do).
# STATS_USER=stats
# STATS_HASH='$2a$14$replace.this.with.your.own.hash'
#
# Where Caddy writes access logs and where it reads the rendered
# dashboard. Both default to /var/lib/gg-analytics, which is also
# where infra/analytics/collect.py keeps its store.
# CADDY_LOG_DIR=/var/lib/gg-analytics/caddy-logs
# ANALYTICS_DIR=/var/lib/gg-analytics

# --- Optional: organization branding ---
# Name of the install's organization, set when the admin first signs
# in. Change it later on Admin -> Branding.
DEFAULT_ORG_NAME=GratisGIS

# portal-api containers. bootstrap.sh writes 1, which fits a 4 GB box.
# Unset means 2, what the public demo runs.
# GG_API_REPLICAS=1

# --- Optional: settings passed to the containers ---
# docker-compose.prod.yml passes each of these to the services that
# read them. Empty or unset keeps the code default.
# infra/check-env-passthrough.py fails CI when code reads a variable
# that the compose file never passes.
#
# Email notifications. Off unless true. Enter SMTP on the admin
# Notifications page, or set SMTP_HOST, SMTP_PORT, SMTP_USER,
# SMTP_PASS, SMTP_FROM and SMTP_SECURE here.
# NOTIFICATIONS_ENABLED=true
# PORTAL_NAME=Acme GIS Portal
#
# Map address search. This stack runs no Nominatim. Unset, searches
# go to the public nominatim.openstreetmap.org. Point NOMINATIM_URL at
# your own instance, or set NOMINATIM_PUBLIC_FALLBACK=0 to keep
# searches off the public service.
# NOMINATIM_URL=http://nominatim.internal:8080
# NOMINATIM_PUBLIC_FALLBACK=0
#
# Portal cookie lifetime and idle window, in seconds
# (docs/operations/session.md).
# GRATIS_SESSION_MAX_AGE_SECONDS=604800
# GRATIS_SESSION_IDLE_SECONDS=28800
#
# Browser origins allowed to call the API (docs/auth-model.md), and
# extra public origins whose Keycloak issuer the API accepts.
# CORS_ALLOWED_ORIGINS=https://embed.example.org
# AUTH_ALLOWED_ORIGINS=https://gis.example.org
#
# Public demo only: stop admins from making anyone else an admin.
# PORTAL_LOCK_ADMIN_TIER=true
#
# Retention and housekeeping. Defaults: recycle bin 30 days, admin
# audit 400 days, item data snapshots 30 days and 20 per item, stale
# items 90 days, quiet users 180 days.
# RECYCLE_BIN_RETENTION_DAYS=30
# GRATIS_ADMIN_AUDIT_RETENTION_DAYS=400
# ITEM_SNAPSHOT_TTL_DAYS=30
# ITEM_SNAPSHOT_CAP_PER_ITEM=20
# HOUSEKEEPING_STALE_ITEM_DAYS=90
# HOUSEKEEPING_STALE_USER_DAYS=180
#
# The organization whose admins see Backup and get backup failure
# email. Unset, the oldest organization is the operator.
# GRATIS_OPERATOR_ORG_ID=
#
# Serve the OpenAPI explorer on portal-api (see the API help page).
# ENABLE_SWAGGER=1
#
# off stops the admin Updates page from calling GitHub.
# UPDATE_CHECK=off

# --- Optional: user scripts (docs/scripts.md) ---
# Off unless all of these are set. bootstrap.sh writes
# SCRIPT_EXECUTOR_TOKEN. COMPOSE_PROFILES makes deploy.sh build and
# start the script-runner and script-executor services.
# PORTAL_SCRIPTS_ENABLED=1
# COMPOSE_PROFILES=scripts
# portal-only keeps scripts off the internet (the fence reads this).
# SCRIPT_EGRESS=portal-only

# --- Offline map packages ---
# Optional mirror for the vector basemap the offline-package worker
# clips per-area downloads from. Unset, the newest public Protomaps
# daily build is resolved automatically. Put NO credentials in this
# URL: it appears in worker logs and error messages.
# PORTAL_BASEMAP_PMTILES_URL=https://example.com/basemaps/daily.pmtiles
