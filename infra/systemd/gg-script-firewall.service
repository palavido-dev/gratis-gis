[Unit]
Description=GratisGIS script-network egress fence (#221)
Documentation=https://github.com/palavido-dev/gratis-gis
# Docker rebuilds its iptables chains when it starts, so these rules
# have to be (re)applied after it, never before.
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Deliberately NOT RemainAfterExit=yes.
#
# That is the obvious setting for a oneshot that installs state, and it
# silently disables the timer. systemd will not activate a unit that is
# already active, and RemainAfterExit leaves this one active(exited)
# forever, so OnUnitActiveSec never comes round again. Caught by looking
# at `systemctl list-timers`, which showed NEXT as "-" after the first
# run: the rules would have been installed once and then never
# re-asserted, which is precisely the failure the timer exists to
# prevent.
# Read SCRIPT_EGRESS from the deployment's env file if it sets one.
# `-` so a box without the file still boots the fence in its default
# (open) mode rather than failing and leaving no rules at all.
EnvironmentFile=-/opt/gratis-gis/infra/.env.prod
ExecStart=/opt/gratis-gis/infra/script-net-firewall.sh
# A transient failure here (docker not answering yet) leaves the unit
# failed until its timer re-runs it a few minutes later, which then
# succeeds. The failed state is visible on purpose.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
