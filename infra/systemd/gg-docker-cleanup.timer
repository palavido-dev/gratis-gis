[Unit]
Description=GratisGIS docker cleanup - run daily at 03:30 UTC
# No Requires=: it started the prune whenever the timer itself started,
# so every boot deleted every image with no container. The timer runs
# gg-docker-cleanup.service by name.

[Timer]
OnCalendar=*-*-* 03:30:00
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
