[Unit]
Description=Collect GratisGIS demo traffic every 15 minutes
Documentation=https://github.com/palavido-dev/gratis-gis

[Timer]
# Every 15 minutes. Frequent enough that the dashboard is never
# meaningfully stale and that an in-progress visit gets its duration
# corrected quickly, cheap enough that it is invisible on the box:
# the collector reads only the bytes appended since the last run.
OnBootSec=5min
OnUnitActiveSec=15min
# OnBootSec above is what runs it soon after a reboot. Persistent=
# applies only to OnCalendar timers, so it is not set here.
Unit=gg-analytics.service

[Install]
WantedBy=timers.target
