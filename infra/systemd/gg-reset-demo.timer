[Unit]
Description=Daily reset timer for the GratisGIS public test instance (#138)
Documentation=https://github.com/palavido-dev/gratis-gis

[Timer]
# 04:00 UTC daily: midnight ET (20:00 to 21:00 Pacific) and before
# business hours in Europe and Africa. The reset takes the demo down
# for about 20 minutes (the GIN rebuild alone is 15 to 20, see
# gg-reset-demo.service), so pick a quieter hour if your testers
# are on the US west coast.
# Persistent=true would catch a missed run on next boot (e.g. host
# rebooted past 04:00), which is desirable: better a reset
# happens at boot time than not at all on a day testers are abusing
# the instance.
OnCalendar=*-*-* 04:00:00 UTC
Persistent=true
# Don't run while the deploy script is actively rolling images.
# deploy.sh, snapshot-golden.sh, and restore-golden.sh all take the
# same flock on /var/lock/gratisgis-deploy.lock; the service unit's
# ExecCondition probes it with `flock -n` and skips this firing
# cleanly when it is held, and restore-golden.sh re-checks the same
# lock itself as the authoritative guard.
Unit=gg-reset-demo.service

[Install]
WantedBy=timers.target
