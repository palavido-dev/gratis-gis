{
  "name": "gratis-gis",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source, self-hosted geospatial portal. Web maps, app builder, offline field collection, and a visual tool builder. Inspired by modern cloud GIS platforms, built on Postgres + PostGIS + MapLibre.",
  "keywords": [
    "gis",
    "geospatial",
    "mapping",
    "webgis",
    "open-source-gis",
    "open-source",
    "self-hosted",
    "postgis",
    "maplibre",
    "offline-first",
    "field-data-collection",
    "form-builder",
    "survey",
    "keycloak",
    "typescript",
    "nextjs",
    "nestjs",
    "react-native",
    "monorepo"
  ],
  "homepage": "https://github.com/palavido-dev/gratis-gis",
  "repository": {
    "type": "git",
    "url": "https://github.com/palavido-dev/gratis-gis.git"
  },
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v && pnpm infra:up"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.11",
    "@types/node": "^25.9.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.6",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "glob": "^11.0.0",
      "path-scurry": "^2.0.0",
      "fast-uri": "^3.1.4",
      "fast-xml-builder": "^1.1.7",
      "lodash": "^4.18.0",
      "picomatch": "^4.0.4",
      "undici": "^6.27.0",
      "multer": "^2.2.0",
      "nodemailer": "^9.0.1",
      "brace-expansion": "^5.0.7",
      "body-parser": "^2.3.0",
      "file-type": "^21.3.2",
      "ip-address": "^10.1.1",
      "js-yaml": "^4.2.0",
      "postcss": "^8.5.10",
      "fast-xml-parser": "^5.7.0",
      "uuid": "^11.1.1",
      "shell-quote": "^1.8.4",
      "hono": "^4.12.25",
      "@hono/node-server": "^1.19.13",
      "esbuild": "^0.28.1",
      "tar": "^7.5.16",
      "sharp": "^0.35.0"
    }
  }
}
