# Dev env template. Copy into each app (each reads the .env in its own
# directory): cp .env.example apps/portal-api/.env
#             cp .env.example apps/portal-web/.env
# Never commit the copies. Production uses infra/.env.prod.example.
# Commented entries are optional; the value shown is the built-in default.

# --- Database ---
# The dev docker-compose Postgres (infra/docker-compose.yml) hardcodes
# these credentials; apps read only this URL.
DATABASE_URL=postgresql://gratisgis:devpassword@localhost:5432/gratisgis?schema=public
# Max connections in the API's Prisma pool.
# DB_POOL_MAX=25

# --- Keycloak ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=gratis-gis
KEYCLOAK_CLIENT_ID_WEB=portal-web
KEYCLOAK_CLIENT_SECRET_WEB=replace-me
# In-network URL the API uses for Keycloak admin calls when the public
# hostname is not reachable from the API container. Falls back to
# KEYCLOAK_URL.
# KEYCLOAK_INTERNAL_URL=http://keycloak:8080
# Full issuer override for operators running a non-Keycloak OIDC
# provider. Default is {KEYCLOAK_URL}/realms/{KEYCLOAK_REALM}.
# OIDC_ISSUER=

# --- Keycloak admin (portal-api -> /admin/users endpoints) ---
# Requires the confidential 'portal-api-admin' client (pre-defined in
# infra/keycloak/realm-gratis-gis.json) with its service-account granted
# the realm-management 'manage-users' role. After first realm import,
# set the client secret in the Keycloak admin console and paste it here.
KEYCLOAK_ADMIN_CLIENT_ID=portal-api-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-me

# --- MinIO ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=gratisgis
MINIO_SECRET_KEY=devpassword
MINIO_BUCKET=gratisgis
# Browser-reachable MinIO base for presigned URLs, when it differs
# from MINIO_ENDPOINT (e.g. behind a proxy). Defaults to MINIO_ENDPOINT.
# MINIO_PUBLIC_BASE=
# CORS allowlist the API applies to the storage bucket.
# STORAGE_ALLOWED_ORIGINS=http://localhost:3000

# --- Services ---
PORTAL_API_URL=http://localhost:4000
# API listen port.
# PORT=4000
# Public API base advertised to external clients (/portal-info).
# Default is derived from the request's Host / X-Forwarded-* headers.
# PORTAL_API_BASE_URL=
# Portal display name + base URL used in email subjects and deep links.
# PORTAL_BASE_URL must be the address a RECIPIENT can open. It defaults
# to localhost:3000, which is correct for local dev and useless in an
# email, so set it on any deployment that sends mail. The prod compose
# derives it from PORTAL_DOMAIN.
# PORTAL_NAME=GratisGIS
# PORTAL_BASE_URL=http://localhost:3000

# --- portal-web ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-long-random-string
# Self-hosted Nominatim geocoder proxied by /api/geocode.
# NOMINATIM_URL=http://localhost:8081
# Public origin of the portal when it differs from NEXTAUTH_URL.
# NEXT_PUBLIC_PORTAL_URL=
# API base the web server falls back to when PORTAL_API_URL is unset.
# NEXT_PUBLIC_PORTAL_API_URL=http://localhost:4000
# Repo shown by the feedback + /why pages ("owner/name").
# NEXT_PUBLIC_GITHUB_REPO=palavido-dev/gratis-gis
# Donation links on /why. Set empty to hide. Defaults point at the
# upstream maintainer, so forks should override these.
# NEXT_PUBLIC_GITHUB_SPONSORS=
# NEXT_PUBLIC_PAYPAL_DONATE=
# Set to 1 to render the public-testing banner on the landing page.
# NEXT_PUBLIC_PUBLIC_TESTING=0
# Set to 1 to force the project landing page variant.
# NEXT_PUBLIC_PROJECT_LANDING=0

# --- Security ---
# Master key for encrypting stored credentials (connected-service
# passwords, SMTP password). Must decode to 32 bytes of base64.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CREDENTIAL_ENCRYPTION_KEY=
# Set to 1/true to lock the admin tier (public-testing hardening:
# admins cannot mint new admins or touch the master admin account).
# PORTAL_LOCK_ADMIN_TIER=0

# --- Feature toggles ---
# Swagger UI at /docs is on outside production; set 1 to force it on.
# ENABLE_SWAGGER=0
# Set to false to disable all scheduled jobs on this process.
# ENABLE_CRONS=true

# --- Ingest + analysis ---
# Scratch dir for staged uploads. Default is <os-tmpdir>/gg-staging;
# prod points this at a volume shared with the analysis worker.
# STAGING_DIR=
# Comma-separated analysis capability tiers enabled on this deploy
# (prod compose sets it where the worker runs). Empty disables.
# ANALYSIS_TIERS=
# Overpass API endpoint for the OSM toolset.
# GRATIS_GIS_OSM_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
# Overrides for bundled content paths (unusual deployments only).
# GRATIS_GIS_OSM_PRESET_CATALOG_PATH=
# GRATIS_GIS_SAMPLE_CONTENT_PATH=

# --- Retention + caches ---
# Days a soft-deleted item stays in the recycle bin before purge.
# RECYCLE_BIN_RETENTION_DAYS=30
# Pre-replace item data snapshots: retention days and per-item cap.
# ITEM_SNAPSHOT_TTL_DAYS=30
# ITEM_SNAPSHOT_CAP_PER_ITEM=20
# In-memory vector tile cache bounds.
# TILE_CACHE_MAX_BYTES=209715200
# TILE_CACHE_MAX_ENTRIES=50000
# TILE_CACHE_TTL_MS=60000
# TILE_CACHE_MAX_CONCURRENT=8
# TILE_CACHE_COMPUTE_TIMEOUT_MS=35000

# --- Print / PDF rendering ---
# Comma-separated Chromium DevTools websocket endpoints; print returns
# 503 until at least one is configured.
# CHROMIUM_WS_ENDPOINTS=
# Base URL the render browser uses to load the preview page.
# PRINT_PREVIEW_BASE_URL=http://portal-web:3000

# --- Email notifications (off by default; see docs/SETUP.md section 8) ---
# These env vars seed the SMTP settings; once an admin saves the
# in-app notification settings form, the DB row wins.
# NOTIFICATIONS_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="GratisGIS <noreply@example.org>"
# SMTP_SECURE=false
# Queue tuning: batch size per drain, retry cap, share-expiry warning.
# NOTIFICATIONS_BATCH_SIZE=25
# NOTIFICATIONS_MAX_ATTEMPTS=5
# NOTIFICATIONS_EXPIRY_WARNING_DAYS=7
# --- In-portal feedback (#146) ---
# OFF by default. Setting this to 1 opens a PUBLIC, unauthenticated
# POST /api/feedback and shows a feedback button on every page,
# including to signed-out visitors. That is what you want on a demo or
# a pilot where you are actively collecting reports; it is probably not
# what you want on an internal portal, which is why an upgrade will
# never turn it on for you.
#
# Submissions are stored in the portal's own database and read under
# Admin -> Feedback. The email below is a notification, not the record,
# so a missing SMTP config loses nothing.
# PORTAL_FEEDBACK_ENABLED=1
#
# Where feedback notifications are emailed. Falls back to ACME_EMAIL.
# With neither set, submissions still persist and still appear in the
# admin view; only the email is skipped.
# FEEDBACK_RECIPIENT_EMAIL=
#
# Salt for the one-way hash of reporter IP addresses, which is all that
# is stored (never the address itself). Used only to rate-limit. When
# unset, a random salt is generated per process, which means the rate
# limit resets on restart and the two API replicas count separately.
# Set it in production; treat it like any other secret.
# FEEDBACK_IP_SALT=

# --- Backup + restore (admin-only feature; see /admin/backup) ---
# Where backup archives land. Relative paths resolve against the API's
# cwd. In production, point this at an on-host volume outside the
# container filesystem. Schedule and retention are managed in the
# admin UI once saved; these env values are first-boot defaults.
BACKUP_DIR=./backups
# How many successful backups to retain. Failed runs are not counted
# against this cap so you can see a streak of failures.
BACKUP_RETENTION_COUNT=7
# If set, pg_dump runs via `docker exec <container> pg_dump` instead
# of shelling out to a host binary. Useful when the API process
# doesn't have pg_dump on PATH (the common Windows dev scenario).
# BACKUP_PGDUMP_DOCKER_CONTAINER=gratis-gis-postgres
# Override the tar binary the archive step shells out to.
# TAR_BIN=tar

# --- Debug timing flags (set to 1 to log request timings) ---
# ITEMS_LIST_TIMING=0   # portal-api items list
# BFF_TIMING=0          # portal-web API proxy route
# API_FETCH_TIMING=0    # portal-web server-side fetches
