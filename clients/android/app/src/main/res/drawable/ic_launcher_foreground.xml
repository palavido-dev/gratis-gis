<?xml version="1.0" encoding="utf-8"?>
<!-- GratisGIS mark: a G drawn as two contour rings around a point.
     Same geometry as portal-web components/brand-mark.tsx (48 grid),
     scaled 1.3x and centred in the 108dp adaptive icon so it sits
     inside the 66dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="22.8"
        android:translateY="22.8"
        android:scaleX="1.3"
        android:scaleY="1.3">
        <path
            android:pathData="M36.73,11.27A18,18 0,1 0,42 24H32"
            android:strokeColor="#F4F2EC"
            android:strokeWidth="3.6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M32.49,15.51A12,12 0,1 0,36 24"
            android:strokeColor="#F4F2EC"
            android:strokeAlpha="0.6"
            android:strokeWidth="3.6"
            android:strokeLineCap="round" />
        <path
            android:pathData="M20.6,24a3.4,3.4 0,1 0,6.8 0a3.4,3.4 0,1 0,-6.8 0z"
            android:fillColor="#F4F2EC" />
    </group>
</vector>
