<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup and device-to-device transfer. Same exclusion as
  backup_rules.xml: the auth SharedPreferences file is not copied.
  https://developer.android.com/about/versions/12/backup-restore
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="gratisgis.field.auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="gratisgis.field.auth.xml" />
    </device-transfer>
</data-extraction-rules>
