{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@gratis-gis/shared-types#build": {
      "outputs": ["dist/**"],
      "inputs": ["src/**/*.ts", "tsconfig.json", "tsconfig.build.json", "package.json"]
    },
    "@gratis-gis/engine#build": {
      "outputs": ["dist/**"],
      "inputs": ["src/**/*.ts", "tsconfig.json", "tsconfig.build.json", "package.json"]
    },
    "@gratis-gis/field-engine#build": {
      // The bundle is built from the SOURCE of form-schema and
      // shared-types (relative imports in src/index.ts), not from
      // their dist, so its own inputs are not enough to key the cache.
      // `^build` keeps it honest: turbo folds the dependency tasks'
      // hashes into this one, so a change in either sibling's src
      // re-runs this build. Do not drop the dependsOn to "speed it up".
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["src/**/*.ts", "build.mjs", "tsconfig.json", "package.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      // Turbo strips env vars it does not know about, and it also has
      // to know these affect the outcome so a cached green run from an
      // env without a database cannot be replayed as a green run WITH
      // one. The first CI run after wiring the pg suites proved the
      // failure mode: TEST_DATABASE_URL was set on the step, turbo
      // filtered it, jest saw nothing, both suites skipped, job green.
      //
      // The script-runner pair was added later and reproduced the same
      // bug: ci.yml set REQUIRE_PYTHON_SPECS but turbo.json was never
      // updated, so the anti-skip guard in
      // script-executor.integration.spec.ts could not fire. SCRIPT_PYTHON
      // belongs here too - on Windows it is the only way to run that
      // suite at all.
      "env": [
        "TEST_DATABASE_URL",
        "REQUIRE_PG_SPECS",
        "REQUIRE_PYTHON_SPECS",
        "SCRIPT_PYTHON"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
